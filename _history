sic.forever(on_forever)\n```\n\nChanging tone by side:\n```python\n# Forever method\ndef on_forever():\n    cuteBot.motors(50, 45)\n    if cuteBot.tracking(cuteBot.TrackingState.L_R_LINE):\n        basic.show_icon(IconNames.HAPPY)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_UNLINE_R_LINE):\n        music.play(music.tone_playable(784, music.beat(BeatFraction.WHOLE)),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.show_icon(IconNames.CONFUSED)\n    else:\n        music.play(music.tone_playable(988, music.beat(BeatFraction.WHOLE)),\n            music.PlaybackMode.UNTIL_DONE)\n        basic.show_icon(IconNames.SAD)\n# Main\nbasic.forever(on_forever)\n```\n\n### Force Lane\nWith music:\n```python\n# Forever method for movement\ndef on_forever():\n    if cuteBot.tracking(cuteBot.TrackingState.L_R_LINE):\n        cuteBot.motors(forward_left_speed, forward_right_speed)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_LINE_R_UNLINE):\n        cuteBot.motors(low_speed_turn, high_speed_turn)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_UNLINE_R_LINE):\n        cuteBot.motors(high_speed_turn, low_speed_turn)\n    else:\n        cuteBot.stopcar()\n        cuteBot.move_time(cuteBot.Direction.BACKWARD, backward_speed, backward_seconds)\nbasic.forever(on_forever)\n\n# Forever method for sounds\ndef on_forever2():\n    music.play(music.built_in_playable_melody(Melodies.PRELUDE),\n        music.PlaybackMode.UNTIL_DONE)\n\n# Main\nhigh_speed_turn = 60\nlow_speed_turn = 10\nforward_left_speed = 50\nforward_right_speed = 47\nbackward_speed = 40\nbackward_seconds = 0.2\nbasic.forever(on_forever2)\n```\n\nForce lane with alarm when obstacle and turn:\n\n","main.py":"high_speed_turn = 60\nlow_speed_turn = 10\nforward_left_speed = 50\nforward_right_speed = 47\nbackward_speed = 40\nbackward_seconds = 0.2\n# def on_forever():\n# music._play_default_background(music.built_in_playable_melody(Melodies.PRELUDE),\n# music.PlaybackMode.UNTIL_DONE)\n# basic.forever(on_forever)\n\ndef on_forever():\n    if cuteBot.ultrasonic(cuteBot.SonarUnit.CENTIMETERS) < 20:\n        cuteBot.stopcar()\n        for index in range(6):\n            music.ring_tone(330)\n        basic.pause(500)\n        cuteBot.move_time(cuteBot.Direction.RIGHT, 60, 0.3)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_R_LINE):\n        cuteBot.motors(forward_left_speed, forward_right_speed)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_LINE_R_UNLINE):\n        cuteBot.motors(low_speed_turn, high_speed_turn)\n    elif cuteBot.tracking(cuteBot.TrackingState.L_UNLINE_R_LINE):\n        cuteBot.motors(high_speed_turn, low_speed_turn)\n    else:\n        cuteBot.stopcar()\n        cuteBot.move_time(cuteBot.Direction.BACKWARD, backward_speed, backward_seconds)\nbasic.forever(on_forever)\n","pxt.json":"{\n    \"name\": \"smart_cutebot_car_technology\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"cutebot\": \"github:elecfreaks/pxt-cutebot#v6.2.4\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"blocksprj\"\n}\n"}},{"timestamp":1771520217939,"editorVersion":"8.0.18","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"%EJv3$^$G[.a0ONN5f:4\">forward_left_speed</variable><variable id=\"h+m2$:Cd.SE+y1-1MIS,\">forward_right_speed</variable><variable id=\"80ob@I14[Upi!~7tptR(\">low_speed_turn</variable><variable id=\"dS:!4L=gb#jPw]TJFdIB\">high_speed_turn</variable><variable id=\"id0IhW1g1rqSbd]66~7#\">backward_speed</variable><variable id=\"RE`,ZUMG@@!NYN)z}-J~\">backward_seconds</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"variables_set\"><field name=\"VAR\" id=\"dS:!4L=gb#jPw]TJFdIB\">high_speed_turn</field><comment pinned=\"false\" h=\"80\" w=\"1